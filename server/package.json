{
  "name": "moy-avtomekhanik-server",
  "version": "1.0.0",
  "private": true,
  "description": "Сервер экосистемы «Мой автомеханик»: синхронизация клиентского приложения, панели СТО, приложения консьержа и панели диспетчера",
  "type": "module",
